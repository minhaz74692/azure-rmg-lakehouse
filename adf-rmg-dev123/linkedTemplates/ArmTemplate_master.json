{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-rmg-dev123"
		},
		"ls_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://rmgdevstorage123.dfs.core.windows.net/"
		},
		"ls_kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-rmg-dev123.vault.azure.net/"
		},
		"ls_postgres_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "psql-rmg-dev123.postgres.database.azure.com"
		},
		"ls_postgres_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "rmg_erp"
		},
		"ls_postgres_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "rmgadmin"
		},
		"rmg_HttpServer_frankfurter_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.frankfurter.dev"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-rmg-dev123_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_accountKey": {
						"value": "[parameters('ls_adls_accountKey')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_kv_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_kv_properties_typeProperties_baseUrl')]"
					},
					"rmg_HttpServer_frankfurter_properties_typeProperties_url": {
						"value": "[parameters('rmg_HttpServer_frankfurter_properties_typeProperties_url')]"
					},
					"ls_postgres_properties_typeProperties_server": {
						"value": "[parameters('ls_postgres_properties_typeProperties_server')]"
					},
					"ls_postgres_properties_typeProperties_database": {
						"value": "[parameters('ls_postgres_properties_typeProperties_database')]"
					},
					"ls_postgres_properties_typeProperties_username": {
						"value": "[parameters('ls_postgres_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}