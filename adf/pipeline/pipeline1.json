{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "nb_bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Shared/adf_test",
					"baseParameters": {
						"batch_id": {
							"value": "@pipeline().RunId",
							"type": "Expression"
						},
						"ingest_date": {
							"value": "@pipeline().parameters.runDate",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"runDate": {
				"type": "string",
				"defaultValue": "2026-08-20"
			}
		},
		"annotations": []
	}
}